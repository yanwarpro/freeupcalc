{
  "manifest_version": 3,
  "name": "FreeUp Calc",
  "version": "1.0.0",
  "description": "Hitung penghasilan bersih di berbagai platform freelance setelah platform fee, connect cost, withdrawal fee, currency conversion, dan VAT.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.upwork.com/*", "https://upwork.com/*", "https://www.freelancer.com/*", "https://freelancer.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeUp Calc"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/*",
        "https://upwork.com/*",
        "https://www.freelancer.com/*",
        "https://freelancer.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/*",
        "https://upwork.com/*",
        "https://www.freelancer.com/*",
        "https://freelancer.com/*"
      ],
      "js": ["scam-detector.js"],
      "css": ["content-scam.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["User_Guide_FreeUp_Calc.pdf", "content-scam.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
